{
  "name": "@funstack/ui",
  "version": "0.1.0-alpha.3",
  "description": "Headless UI library for React — the first Async React-native UI library",
  "keywords": [
    "components",
    "headless",
    "react",
    "suspense",
    "transitions",
    "ui"
  ],
  "homepage": "https://ui.funstack.work/",
  "bugs": {
    "url": "https://github.com/uhyo/funstack-ui/issues"
  },
  "license": "MIT",
  "author": "uhyo <uhyo@uhy.ooo>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uhyo/funstack-ui.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./accordion": "./dist/accordion/index.mjs",
    "./checkbox": "./dist/checkbox/index.mjs",
    "./checkbox-group": "./dist/checkbox-group/index.mjs",
    "./combobox": "./dist/combobox/index.mjs",
    "./dialog": "./dist/dialog/index.mjs",
    "./field": "./dist/field/index.mjs",
    "./form": "./dist/form/index.mjs",
    "./menu": "./dist/menu/index.mjs",
    "./meter": "./dist/meter/index.mjs",
    "./popover": "./dist/popover/index.mjs",
    "./progress": "./dist/progress/index.mjs",
    "./radio-group": "./dist/radio-group/index.mjs",
    "./select": "./dist/select/index.mjs",
    "./slider": "./dist/slider/index.mjs",
    "./switch": "./dist/switch/index.mjs",
    "./tabs": "./dist/tabs/index.mjs",
    "./toast": "./dist/toast/index.mjs",
    "./toggle": "./dist/toggle/index.mjs",
    "./tooltip": "./dist/tooltip/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:jsdom": "vitest run --project jsdom",
    "test:browser": "vitest run --project browser",
    "test:browser:dev": "vitest --project browser --browser.headless=false",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=19.3.0",
    "react-dom": ">=19.3.0"
  }
}
